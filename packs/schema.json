{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seekto pack",
  "type": "object",
  "required": ["schema", "id", "title", "language", "source", "license", "transcript"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
    "title": { "type": "string", "minLength": 1 },
    "subject": { "type": "string" },
    "language": { "type": "string", "minLength": 2 },
    "duration": { "type": "number", "minimum": 0 },
    "source": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": { "enum": ["original", "course-site", "creator-captions", "connected-channel"] },
        "name": { "type": "string" },
        "url": { "type": ["string", "null"] }
      }
    },
    "video": {
      "type": ["object", "null"],
      "required": ["provider", "id"],
      "properties": {
        "provider": { "enum": ["youtube"] },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" }
      }
    },
    "license": {
      "type": "object",
      "required": ["spdx", "attribution"],
      "properties": {
        "spdx": { "enum": ["CC-BY-4.0", "CC-BY-SA-4.0", "CC-BY-SA-3.0", "CC-BY-NC-SA-4.0", "CC-BY-NC-SA-3.0", "CC0-1.0"] },
        "attribution": { "type": "string", "minLength": 1 },
        "url": { "type": "string" }
      }
    },
    "transcript": { "type": "string", "pattern": "\\.(vtt|srt)$" },
    "suggestedQuestions": { "type": "array", "items": { "type": "string" } }
  }
}
